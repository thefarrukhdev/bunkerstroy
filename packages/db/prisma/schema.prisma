generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPPLIER
  CONTRACTOR
  LOGISTICS_DRIVER
  ESCO_AUDITOR
  CLIENT
}

enum UserType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  ACCEPTED
  PACKING
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  FULLY_PAID
  RECEIVED
  COMPLETED
  CANCELLED
  DISPUTE
  RETURN_REQUESTED
  RETURNED

  // Legacy mappings for backward compatibility
  PENDING
  CONFIRMED
  ASSIGNED_TO_FLEET
  DELIVERED
}

enum PaymentProvider {
  PAYME
  CLICK
  UZUM
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  PREAUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMode {
  FULL_100
  SPLIT_50_50
}

enum SupplierType {
  LOCAL
  GLOBAL
}

enum VehicleType {
  DUMP_TRUCK_SAMOSVAL
  CONCRETE_MIXER
  CRANE_MANIPULATOR
  GAZEL_LIGHT_TRUCK
  SEMI_TRAILER_FURA
}

model User {
  id                    String              @id @default(uuid())
  phone                 String              @unique
  email                 String?             @unique
  passwordHash          String
  displayName           String
  firstName             String?
  lastName              String?
  role                  Role                @default(CLIENT)
  userType              UserType            @default(INDIVIDUAL)
  verificationStatus    VerificationStatus  @default(PENDING)
  supplierType          SupplierType        @default(LOCAL)
  isAllowedSplitPayment Boolean             @default(false)
  rating                Float               @default(5.0)
  isBlocked             Boolean             @default(false)
  inn                   String?             @db.VarChar(9)
  companyName           String?
  region                String?
  district              String?
  mahalla               String?
  contractNumber        String?
  eimzoSerialNumber     String?
  eimzoVerifiedAt       DateTime?
  avatarUrl             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  company               Company?            @relation(fields: [inn], references: [inn])
  suppliedProducts      Product[]           @relation("SupplierProducts")
  orders                Order[]             @relation("ClientOrders")
  assignedDispatches    LogisticsDispatch[] @relation("DriverDispatches")
  supplierSubOrders     SubOrder[]          @relation("SupplierSubOrders")
  driverSubOrders       SubOrder[]          @relation("DriverSubOrders")
  openedDisputes        Dispute[]           @relation("UserDisputes")
  escoAudits            EscoAudit[]
  auditLogs             AuditLog[]

  @@index([role])
  @@index([inn])
  @@index([supplierType])
}

model Company {
  inn               String             @id @db.VarChar(9)
  companyName       String
  shortName         String?
  status            String             @default("ACTIVE")
  statusDescription String             @default("Faol korxona")
  director          String?
  address           String?
  region            String?
  district          String?
  registrationDate  DateTime?
  activityType      String?
  vatPayer          Boolean            @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  users             User[]
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  parentId    String?
  icon        String?
  orderIndex  Int        @default(0)
  createdAt   DateTime   @default(now())

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
}

model Product {
  id                     String               @id @default(uuid())
  title                  String
  titleRu                String?
  slug                   String               @unique
  categoryId             String
  supplierId             String
  price                  Decimal              @db.Decimal(14, 2)
  b2bPrice               Decimal?             @db.Decimal(14, 2)
  unit                   String               @default("dona")
  stock                  Int                  @default(0)
  minOrder               Int                  @default(1)
  energyEfficiencyRating String               @default("STANDARD")
  isEscoCertified        Boolean              @default(false)
  description            String               @db.Text
  descriptionRu          String?              @db.Text
  itemType               String               @default("MATERIAL")
  repairType             String               @default("UNIVERSAL")
  region                 String?
  district               String?
  certificateUrl         String?
  images                 String[]             @default([])
  warranty               String?
  hasDelivery            Boolean              @default(true)
  hasBonus               Boolean              @default(false)
  bonusDescription       String?
  bonusThreshold         Decimal?             @db.Decimal(14, 2)
  bonusAmount            Decimal?             @db.Decimal(14, 2)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  category               Category             @relation(fields: [categoryId], references: [id])
  supplier               User                 @relation("SupplierProducts", fields: [supplierId], references: [id])
  variants               ProductVariant[]
  tieredPrices           ProductTieredPrice[]
  orderItems             OrderItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([region])
}

model ProductTieredPrice {
  id        String   @id @default(uuid())
  productId String
  minQty    Int
  maxQty    Int?
  price     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  sku        String   @unique
  color      String?
  size       String?
  weight     String?
  length     String?
  priceDelta Decimal  @default(0) @db.Decimal(12, 2)
  stock      Int      @default(0)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                       String               @id @default(uuid())
  orderNumber              String               @unique
  buyerId                  String
  totalAmount              Decimal              @db.Decimal(14, 2)
  deliveryFee              Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount           Decimal              @default(0) @db.Decimal(12, 2)
  finalAmount              Decimal              @db.Decimal(14, 2)
  status                   OrderStatus          @default(PENDING_PAYMENT)
  paymentMode              PaymentMode          @default(FULL_100)
  firstPaymentAmount       Decimal?             @db.Decimal(14, 2)
  secondPaymentAmount      Decimal?             @db.Decimal(14, 2)
  isFirstPaid              Boolean              @default(false)
  isSecondPaid             Boolean              @default(false)
  acceptanceCode           String?
  isAcceptanceCodeRevealed Boolean              @default(false)
  arrivedAt                DateTime?
  waitingDeadline          DateTime?
  deliveryRegion           String
  deliveryDistrict         String
  deliveryStreet           String?
  deliveryLandmark         String?
  deliveryLat              Float?
  deliveryLng              Float?
  vehicleType              String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  buyer                    User                 @relation("ClientOrders", fields: [buyerId], references: [id])
  items                    OrderItem[]
  subOrders                SubOrder[]
  payments                 PaymentTransaction[]
  dispatches               LogisticsDispatch[]
  disputes                 Dispute[]

  @@index([buyerId])
  @@index([status])
  @@index([paymentMode])
}

model SubOrder {
  id             String      @id @default(uuid())
  orderId        String
  supplierId     String
  status         OrderStatus @default(PENDING_PAYMENT)
  subTotal       Decimal     @db.Decimal(14, 2)
  deliveryFee    Decimal     @default(0) @db.Decimal(12, 2)
  acceptanceCode String?
  arrivedAt      DateTime?
  completedAt    DateTime?
  driverId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier       User        @relation("SupplierSubOrders", fields: [supplierId], references: [id])
  driver         User?       @relation("DriverSubOrders", fields: [driverId], references: [id])
  items          OrderItem[]

  @@index([orderId])
  @@index([supplierId])
  @@index([driverId])
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String
  subOrderId   String?
  productId    String
  quantity     Int
  unit         String
  unitPrice    Decimal   @db.Decimal(14, 2)
  totalPrice   Decimal   @db.Decimal(14, 2)

  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder     SubOrder? @relation(fields: [subOrderId], references: [id], onDelete: SetNull)
  product      Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([subOrderId])
}

model PaymentTransaction {
  id             String          @id @default(uuid())
  orderId        String
  provider       PaymentProvider
  transactionId  String          @unique
  paymentType    String          @default("FULL") // FULL, FIRST_50, SECOND_50
  amount         Decimal         @db.Decimal(14, 2)
  status         PaymentStatus   @default(PENDING)
  qrReceiptUrl   String?
  rawWebhookData Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order          Order           @relation(fields: [orderId], references: [id])
}

model Dispute {
  id             String    @id @default(uuid())
  orderId        String
  openedById     String
  reason         String
  evidenceUrls   String[]  @default([])
  status         String    @default("OPEN") // OPEN, RESOLVED_REFUND, REJECTED
  resolutionNote String?
  refundAmount   Decimal?  @db.Decimal(14, 2)
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy       User      @relation("UserDisputes", fields: [openedById], references: [id])

  @@index([orderId])
  @@index([openedById])
}

model PartnerIntegration {
  id          String    @id @default(uuid())
  code        String    @unique // PAYME, CLICK, ESCROW_BANK, E_IMZO, ESKIZ_SMS, GPS_TRACKER
  name        String
  provider    String
  status      String    @default("OPERATIONAL") // OPERATIONAL, DEGRADED, DOWN
  contractEnd DateTime?
  lastSyncAt  DateTime  @default(now())
  errorCount  Int       @default(0)
  details     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LogisticsVehicle {
  id                  String              @id @default(uuid())
  name                String
  type                VehicleType
  plateNumber         String?             @unique
  capacityTons        Float
  basePrice           Decimal             @db.Decimal(12, 2)
  pricePerKm          Decimal             @db.Decimal(12, 2)
  isAvailable         Boolean             @default(true)
  driverName          String
  driverPhone         String
  currentLocationName String
  imageUrl            String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  dispatches          LogisticsDispatch[]
}

model LogisticsDispatch {
  id                     String            @id @default(uuid())
  orderId                String
  vehicleId              String?
  driverId               String?
  status                 String            @default("ASSIGNED")
  origin                 String
  destination            String
  distanceKm             Float
  totalCost              Decimal           @db.Decimal(12, 2)
  acceptanceCode         String?
  acceptancePhotoUrl     String?
  loadedAt               DateTime?
  loadingPhotoUrl        String?
  arrivedAt              DateTime?
  waitingTimerExpiresAt  DateTime?
  issueReason            String?
  issuePhotoUrl          String?
  dispatchedAt           DateTime          @default(now())
  deliveredAt            DateTime?

  order                  Order             @relation(fields: [orderId], references: [id])
  vehicle                LogisticsVehicle? @relation(fields: [vehicleId], references: [id])
  driver                 User?             @relation("DriverDispatches", fields: [driverId], references: [id])
}

model EscoAudit {
  id                    String   @id @default(uuid())
  clientId              String
  buildingType          String
  areaM2                Float
  currentEnergyUsageKwh Float
  estimatedSavingsPct   Float
  annualSavingsSum      Decimal  @db.Decimal(14, 2)
  paybackYears          Float
  co2ReductionTons      Float
  recommendations       String[]
  insulationAdvice      String   @db.Text
  createdAt             DateTime @default(now())

  client                User     @relation(fields: [clientId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  category      String
  details       String   @db.Text
  previousState Json?
  newState      Json?
  ipAddress     String?
  level         String   @default("INFO")
  createdAt     DateTime @default(now())

  actor         User?    @relation(fields: [actorId], references: [id])

  @@index([category])
  @@index([createdAt])
}
