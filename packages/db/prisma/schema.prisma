generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPPLIER
  CONTRACTOR
  LOGISTICS_DRIVER
  ESCO_AUDITOR
  CLIENT
}

enum UserType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED_TO_FLEET
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  PAYME
  CLICK
  UZUM
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  PREAUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum VehicleType {
  DUMP_TRUCK_SAMOSVAL
  CONCRETE_MIXER
  CRANE_MANIPULATOR
  GAZEL_LIGHT_TRUCK
  SEMI_TRAILER_FURA
}

model User {
  id                 String             @id @default(uuid())
  phone              String             @unique
  email              String?            @unique
  passwordHash       String
  displayName        String
  firstName          String?
  lastName           String?
  role               Role               @default(CLIENT)
  userType           UserType           @default(INDIVIDUAL)
  verificationStatus VerificationStatus @default(PENDING)
  inn                String?            @db.VarChar(9)
  companyName        String?
  region             String?
  district           String?
  mahalla            String?
  contractNumber     String?
  eimzoSerialNumber  String?
  eimzoVerifiedAt    DateTime?
  avatarUrl          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company            Company?           @relation(fields: [inn], references: [inn])
  suppliedProducts   Product[]          @relation("SupplierProducts")
  orders             Order[]            @relation("ClientOrders")
  assignedDispatches LogisticsDispatch[] @relation("DriverDispatches")
  escoAudits         EscoAudit[]
  auditLogs          AuditLog[]

  @@index([role])
  @@index([inn])
}

model Company {
  inn               String             @id @db.VarChar(9)
  companyName       String
  shortName         String?
  status            String             @default("ACTIVE")
  statusDescription String             @default("Faol korxona")
  director          String?
  address           String?
  region            String?
  district          String?
  registrationDate  DateTime?
  activityType      String?
  vatPayer          Boolean            @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  users             User[]
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  parentId    String?
  icon        String?
  orderIndex  Int        @default(0)
  createdAt   DateTime   @default(now())

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
}

model Product {
  id                     String          @id @default(uuid())
  title                  String
  slug                   String          @unique
  categoryId             String
  supplierId             String
  price                  Decimal         @db.Decimal(14, 2)
  unit                   String          @default("dona")
  stock                  Int             @default(0)
  minOrder               Int             @default(1)
  energyEfficiencyRating String          @default("STANDARD")
  isEscoCertified        Boolean         @default(false)
  description            String          @db.Text
  itemType               String          @default("MATERIAL")
  repairType             String          @default("UNIVERSAL")
  region                 String?
  district               String?
  images                 String[]        @default([])
  warranty               String?
  hasDelivery            Boolean         @default(true)
  hasBonus               Boolean         @default(false)
  bonusDescription       String?
  bonusThreshold         Decimal?        @db.Decimal(14, 2)
  bonusAmount            Decimal?        @db.Decimal(14, 2)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  category               Category        @relation(fields: [categoryId], references: [id])
  supplier               User            @relation("SupplierProducts", fields: [supplierId], references: [id])
  variants               ProductVariant[]
  orderItems             OrderItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([region])
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  sku        String   @unique
  color      String?
  size       String?
  weight     String?
  length     String?
  priceDelta Decimal  @default(0) @db.Decimal(12, 2)
  stock      Int      @default(0)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                 String              @id @default(uuid())
  orderNumber        String              @unique
  buyerId            String
  totalAmount        Decimal             @db.Decimal(14, 2)
  deliveryFee        Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(12, 2)
  finalAmount        Decimal             @db.Decimal(14, 2)
  status             OrderStatus         @default(PENDING)
  deliveryRegion     String
  deliveryDistrict   String
  deliveryStreet     String?
  deliveryLandmark   String?
  deliveryLat        Float?
  deliveryLng        Float?
  vehicleType        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  buyer              User                @relation("ClientOrders", fields: [buyerId], references: [id])
  items              OrderItem[]
  payments           PaymentTransaction[]
  dispatches         LogisticsDispatch[]

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  unit         String
  unitPrice    Decimal  @db.Decimal(14, 2)
  totalPrice   Decimal  @db.Decimal(14, 2)

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
}

model PaymentTransaction {
  id             String          @id @default(uuid())
  orderId        String
  provider       PaymentProvider
  transactionId  String          @unique
  amount         Decimal         @db.Decimal(14, 2)
  status         PaymentStatus   @default(PENDING)
  rawWebhookData Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order          Order           @relation(fields: [orderId], references: [id])
}

model LogisticsVehicle {
  id                  String              @id @default(uuid())
  name                String
  type                VehicleType
  plateNumber         String?             @unique
  capacityTons        Float
  basePrice           Decimal             @db.Decimal(12, 2)
  pricePerKm          Decimal             @db.Decimal(12, 2)
  isAvailable         Boolean             @default(true)
  driverName          String
  driverPhone         String
  currentLocationName String
  imageUrl            String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  dispatches          LogisticsDispatch[]
}

model LogisticsDispatch {
  id           String            @id @default(uuid())
  orderId      String
  vehicleId    String?
  driverId     String?
  status       String            @default("ASSIGNED")
  origin       String
  destination  String
  distanceKm   Float
  totalCost    Decimal           @db.Decimal(12, 2)
  dispatchedAt DateTime          @default(now())
  deliveredAt  DateTime?

  order        Order             @relation(fields: [orderId], references: [id])
  vehicle      LogisticsVehicle? @relation(fields: [vehicleId], references: [id])
  driver       User?             @relation("DriverDispatches", fields: [driverId], references: [id])
}

model EscoAudit {
  id                    String   @id @default(uuid())
  clientId              String
  buildingType          String
  areaM2                Float
  currentEnergyUsageKwh Float
  estimatedSavingsPct   Float
  annualSavingsSum      Decimal  @db.Decimal(14, 2)
  paybackYears          Float
  co2ReductionTons      Float
  recommendations       String[]
  insulationAdvice      String   @db.Text
  createdAt             DateTime @default(now())

  client                User     @relation(fields: [clientId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  category  String
  details   String   @db.Text
  ipAddress String?
  level     String   @default("INFO")
  createdAt DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id])
  @@index([category])
  @@index([createdAt])
}
