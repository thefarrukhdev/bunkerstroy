{
  "name": "bunkerstroy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BunkerStroy — B2B Building Materials Marketplace, Heavy Logistics, ESCO Energy Audit & Gemini AI Platform",
  "packageManager": "pnpm@10.12.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @bunkerstroy/db generate",
    "db:migrate": "pnpm --filter @bunkerstroy/db migrate",
    "db:seed": "pnpm --filter @bunkerstroy/db seed",
    "mobile:build": "pnpm --filter @bunkerstroy/web cap:build",
    "mobile:sync": "pnpm --filter @bunkerstroy/web cap:sync",
    "mobile:android": "pnpm --filter @bunkerstroy/web cap:android",
    "mobile:ios": "pnpm --filter @bunkerstroy/web cap:ios"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
