# ==========================================
# BUNKERSTROY MONOREPO DOCKERIGNORE
# Prevents host artifacts, secrets, and caches from entering build context
# ==========================================

# Dependencies
node_modules
**/node_modules

# Git repository & CI/CD
.git
.github

# Environment & local secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Build caches & outputs
.turbo
dist
**/dist
build
**/build
.next
**/.next
out
**/out
.output
**/.output
.cache
**/.cache

# Test coverage & reports
coverage
**/coverage
.nyc_output

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Documentation & large PDFs
*.pdf
docs/
TZ_ADMIN.md
TZ.md

# OS & Editor files
.DS_Store
Thumbs.db
.idea
.vscode
*.swp
*.swo
