# ==============================================================================
# BUNKERSTROY PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Node
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://bunker_user:bunker_secret_pass@localhost:5432/bunkerstroy_db?schema=public

# Redis Cache & Background Queue
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_bunker_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_bunker_refresh_jwt_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Eskiz.uz SMS Gateway
ESKIZ_EMAIL=notify@bunkerstroy.uz
ESKIZ_PASSWORD=your_eskiz_password
ESKIZ_FROM=4546

# E-IMZO Service (O'zbekiston Davlat Soliq Qo'mitasi / E-IMZO)
EIMZO_API_URL=https://e-imzo.soliq.uz/api
EIMZO_MOCK_MODE=true

# Soliq STIR / INN Open Data API
SOLIQ_API_URL=https://api.soliq.uz/v1/taxpayer
SOLIQ_API_TOKEN=your_soliq_token
SOLIQ_MOCK_MODE=true

# Payment Providers (Merchant Gateways)
# Payme
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key
PAYME_TEST_MODE=true

# Click
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key

# Uzum Pay
UZUM_MERCHANT_ID=your_uzum_merchant_id
UZUM_SECRET_KEY=your_uzum_secret_key
